{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "../src/lib/wealthEngine.ts",
    "../src/lib/monteCarlo.ts",
    "../src/lib/random.ts",
    "../src/lib/returns.ts",
    "../src/lib/riskQuestionnaire.ts",
    "../src/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
