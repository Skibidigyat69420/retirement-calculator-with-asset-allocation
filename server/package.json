{
  "name": "stw-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Core backend API for the multi-tenant wealth-practitioner platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^11.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.0.11",
    "pino": "^9.7.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
