{
  "name": "soundthesis-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean backend API shell for the Sound Thesis frontend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "fastify": "^5.3.3",
    "tsx": "^4.20.3",
    "zod": "^4.1.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "~5.9.2"
  }
}
