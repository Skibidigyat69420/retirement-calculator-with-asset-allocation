# ---- Server ----
# Port the API listens on
PORT=4000
# Node environment: development | production | test
# In production, internal error details are never leaked in responses.
NODE_ENV=development
# Pino log level (fatal|error|warn|info|debug|trace|silent)
LOG_LEVEL=info

# ---- Database ----
# postgres.js connection string. REQUIRED — the server refuses to boot without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ---- Auth ----
# Auth provider mode:
#   dev      = LOCAL DEVELOPMENT ONLY. Accepts HS256 JWTs signed with SUPABASE_JWT_SECRET.
#              Never enable in production.
#   supabase = Verify against the Supabase JWKS (RS256) with HS256 fallback for
#              legacy Supabase JWTs.
AUTH_MODE=dev

# Supabase project URL (used in 'supabase' mode to build the JWKS URL and issuer)
SUPABASE_URL=
# Supabase service-role key (used for service-role/system operations that bypass tenant RLS)
SUPABASE_SERVICE_ROLE_KEY=
# HS256 secret. In 'dev' mode this is the signing/verification key for local JWTs.
# In 'supabase' mode this is the fallback secret for legacy Supabase JWTs.
SUPABASE_JWT_SECRET=dev-only-secret-change-me
# Optional explicit JWKS URL. Defaults to `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`
SUPABASE_JWKS_URL=

# ---- Engine ----
# Version stamp recorded on plan versions / scenarios / health payload
ENGINE_VERSION=1.0.0

# ---- Seeding ----
# Must be exactly 'true' to run scripts/seed.ts. Local development only.
ALLOW_SEED=false
