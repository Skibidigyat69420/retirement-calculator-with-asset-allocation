# Runtime settings for local Fastify development.
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Supabase transaction-pooler connection string. Keep this server-only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project settings. The publishable key can be used to verify JWTs;
# do not put a service-role key in this file or in VITE_* variables.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Comma-separated frontend origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173

# Local development only. Never enable this in Vercel Preview or Production.
SEED_DEMO_WORKSPACE=false
