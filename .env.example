# Angel One SmartAPI Credentials
# These are used only by local Python data-fetch scripts. They are NOT injected
# into the browser bundle. Enter credentials manually in the Angel Connect page
# each session; they are never persisted in browser storage.
# Replace placeholders with your own values and never commit real secrets.
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_mpin_or_password_here
ANGEL_TOTP_SECRET=your_totp_qr_secret_here

# System Network Parameters
# Provide the values for the machine running the data-fetch scripts.
ANGEL_LOCAL_IP=your_local_ip_here
ANGEL_PUBLIC_IP=your_public_ip_here
ANGEL_MAC_ADDRESS=your_mac_address_here
