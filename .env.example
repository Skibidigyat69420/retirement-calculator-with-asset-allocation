# Practitioner backend API
# Leave unset in local dev (Vite proxies /api/v1 → http://localhost:4000).
# In production set this to the deployed backend, e.g.:
#   VITE_API_BASE_URL=https://stw-api.onrender.com/api/v1
VITE_API_BASE_URL=

# docker-compose (self-hosted stack)
# Required for `docker compose up` (values live in your local .env, never in git)
POSTGRES_PASSWORD=change-me-long-random
# Backend JWT signing secret. Use a long random value in real deployments.
SUPABASE_JWT_SECRET=change-me-jwt-secret
AUTH_MODE=dev

# Authentication (Supabase; browser-safe publishable key only)
# Local demo only: set VITE_AUTH_MODE=dev. Production builds ignore demo mode.
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Production only: set this to your deployed app origin so Supabase emails do not point to localhost.
# Example: https://your-app.vercel.app
VITE_AUTH_REDIRECT_ORIGIN=

# Backend runtime
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only AES-256-GCM key for encrypted client fields. Use a random
# 32-byte key encoded as 64 hexadecimal characters. Keep the same value in
# local server/.env and Vercel; never expose it through a VITE_ variable.
FIELD_ENCRYPTION_KEY=
SEED_DEMO_WORKSPACE=false
