# Angel One SmartAPI Credentials
# The app will use VITE_ANGEL_API_KEY at build time if set.
# You can also paste the key manually in the Angel Connect page.
# Replace with your Angel One credentials.
# Do not commit the real values to version control.
ANGEL_API_KEY=your_api_key_here
VITE_ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_mpin_or_password_here
ANGEL_TOTP_SECRET=your_totp_qr_secret_here

# System Network Parameters (Pre-configured for this machine)
ANGEL_LOCAL_IP=192.168.68.61
ANGEL_PUBLIC_IP=122.170.251.47
ANGEL_MAC_ADDRESS=b0:22:7a:74:16:ec
